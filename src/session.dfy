  requires inv(st)
  requires (0 <= i)
  requires (i < |step(st, ev).cmds|)
  requires step(st, ev).cmds[i].callProvider?
  ensures step(st, ev).st.phase.awaitingProvider?
  ensures wellFormed(step(st, ev).st.msgs)
  ensures ((st.maxTurns > 0) ==> (step(st, ev).st.turns <= st.maxTurns))
{
