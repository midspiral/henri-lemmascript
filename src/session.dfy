lemma stepSummarizeSafe_ensures(st: Session, ev: SEvent, i: int)
  requires inv(st)
  requires (0 <= i)
  requires (i < |step(st, ev).cmds|)
  requires step(st, ev).cmds[i].summarize?
  ensures step(st, ev).st.phase.awaitingSummary?
  ensures (step(st, ev).st.phase.cut == step(st, ev).cmds[i].cut)
  ensures (0 < step(st, ev).cmds[i].cut)
  ensures (step(st, ev).cmds[i].cut <= |step(st, ev).st.msgs|)
  ensures ((step(st, ev).cmds[i].cut == |step(st, ev).st.msgs|) || headOk(step(st, ev).st.msgs[step(st, ev).cmds[i].cut]))
{
  StepOk(st, ev);
}

function stepPermsStable(st: Session, ev: SEvent): bool
  requires inv(st)
  requires (!ev.promptAnswer?)
{
  true
}

lemma stepPermsStable_ensures(st: Session, ev: SEvent)
  requires inv(st)
  requires (!ev.promptAnswer?)
  ensures (step(st, ev).st.perms == st.perms)
{
  StepOk(st, ev);
}

