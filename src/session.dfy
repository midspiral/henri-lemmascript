// Generated by lsc from session.ts

function {:axiom} wellFormed(msgs: seq<TMsg>): bool

function {:axiom} pairs(calls: seq<TToolCall>, results: seq<TToolResult>): bool

function {:axiom} pairsTo(calls: seq<TToolCall>, results: seq<TToolResult>): bool

function {:axiom} headOk(m: TMsg): bool

function {:axiom} initialMsgs(): seq<TMsg>
  ensures wellFormed(initialMsgs())
  ensures (|initialMsgs()| == 0)

function {:axiom} decide(st: PermState, cwd: seq<string>, req: Req): Outcome
  ensures (decide(st, cwd, req).Allow? == isAllowed(st, cwd, req))
  ensures (st.rejectPrompts ==> (!decide(st, cwd, req).Prompt?))

function {:axiom} appendAnsweredBlock(msgs: seq<TMsg>, calls: seq<TToolCall>, results: seq<TToolResult>): seq<TMsg>
  requires wellFormed(msgs)
  requires (|calls| > 0)
  requires pairs(calls, results)
  ensures wellFormed(appendAnsweredBlock(msgs, calls, results))
  ensures (|appendAnsweredBlock(msgs, calls, results)| == (|msgs| + 2))

function {:axiom} pushResult(calls: seq<TToolCall>, done: seq<TToolResult>, isError: bool): seq<TToolResult>
  requires pairsTo(calls, done)
  requires (|done| < |calls|)
  ensures pairsTo(calls, pushResult(calls, done, isError))
  ensures (|pushResult(calls, done, isError)| == (|done| + 1))
  ensures ((|pushResult(calls, done, isError)| == |calls|) ==> pairs(calls, pushResult(calls, done, isError)))

function {:axiom} findCut(msgs: seq<TMsg>, keepRecent: int): int
  requires (0 <= keepRecent)
  ensures ((0 <= findCut(msgs, keepRecent)) && (findCut(msgs, keepRecent) <= |msgs|))
  ensures ((findCut(msgs, keepRecent) == |msgs|) || headOk(msgs[findCut(msgs, keepRecent)]))

function {:axiom} appendUserMsg(msgs: seq<TMsg>): seq<TMsg>
  requires wellFormed(msgs)
  ensures wellFormed(appendUserMsg(msgs))
  ensures (|appendUserMsg(msgs)| == (|msgs| + 1))

function {:axiom} appendAssistantDone(msgs: seq<TMsg>): seq<TMsg>
  requires wellFormed(msgs)
  ensures wellFormed(appendAssistantDone(msgs))
  ensures (|appendAssistantDone(msgs)| == (|msgs| + 1))

function {:axiom} startResults(calls: seq<TToolCall>): seq<TToolResult>
  ensures pairsTo(calls, startResults(calls))
  ensures (|startResults(calls)| == 0)

function {:axiom} grantFor(st: PermState, cwd: seq<string>, req: Req): PermState
  ensures isAllowed(grantFor(st, cwd, req), cwd, req)
  ensures (grantFor(st, cwd, req).rejectPrompts == st.rejectPrompts)
  ensures (grantFor(st, cwd, req).autoAllow == st.autoAllow)
  ensures (grantFor(st, cwd, req).autoAllowCwd == st.autoAllowCwd)
  ensures (grantFor(st, cwd, req).allowAll == st.allowAll)

function {:axiom} grantAll(st: PermState, cwd: seq<string>, req: Req): PermState
  ensures isAllowed(grantAll(st, cwd, req), cwd, req)
  ensures (grantAll(st, cwd, req).rejectPrompts == st.rejectPrompts)

function {:axiom} fillRest(calls: seq<TToolCall>, done: seq<TToolResult>): seq<TToolResult>
  requires (|done| <= |calls|)
  ensures (pairsTo(calls, done) ==> pairs(calls, fillRest(calls, done)))

function {:axiom} compact(msgs: seq<TMsg>, c: int): seq<TMsg>
  requires ((0 <= c) && (c <= |msgs|))
  ensures (wellFormed(msgs) ==> ((c == |msgs|) || headOk(msgs[c])) ==> wellFormed(compact(msgs, c)))
  ensures (|compact(msgs, c)| == ((|msgs| - c) + 1))

function {:axiom} isAllowed(st: PermState, cwd: seq<string>, req: Req): bool

datatype SCall = SCall(id: string, name: string, req: Req, known: bool, noPerm: bool, argsOk: bool)

datatype Answer = yes | no | always | all

datatype SEvent = userInput | compactRequest(keep: int) | providerReply(calls: seq<SCall>, contextTokens: int) | providerInterrupted | toolDone(isError: bool) | promptAnswer(answer: Answer) | batchInterrupted | summaryReady(ok: bool)

datatype SCommand = callProvider | execTool(call: SCall) | askUser(call: SCall) | skipTool(call: SCall, reason: Verdict) | summarize(cut: int)

datatype SPhase = idle | awaitingProvider | toolBatch(calls: seq<SCall>, done: seq<TToolResult>) | awaitingPrompt(calls: seq<SCall>, done: seq<TToolResult>) | awaitingSummary(cut: int)

datatype Session = Session(msgs: seq<TMsg>, perms: PermState, cwd: seq<string>, phase: SPhase, turns: int, maxTurns: int, compactKeep: int, autoCompactAt: int, lastContextTokens: int)

datatype StepOut = StepOut(st: Session, cmds: seq<SCommand>)

datatype Verdict = exec | prompt | skipUnknown | skipDenied | skipMissingArgs

datatype TToolResult = TToolResult(toolCallId: string, isError: bool)

datatype TToolCall = TToolCall(id: string, name: string)

datatype Req = bash(command: string) | path(tool: string, segs: seq<string>, absolute: bool) | other(tool: string)

datatype Outcome = Allow | Deny | Prompt

datatype TMsg = user | assistant(toolCalls: seq<TToolCall>) | tool(toolResults: seq<TToolResult>)

datatype PermState = PermState(autoAllow: set<string>, autoAllowCwd: set<string>, allowedTools: set<string>, allowedBashCommands: set<string>, allowedPaths: seq<PathGrant>, allowAll: bool, rejectPrompts: bool)

datatype PathGrant = PathGrant(tool: string, segs: seq<string>)

function phIdle(): SPhase
{
  SPhase.idle
}

function phAwaitingProvider(): SPhase
{
  SPhase.awaitingProvider
}

function phToolBatch(calls: seq<SCall>, done: seq<TToolResult>): SPhase
{
  toolBatch(calls, done)
}

function phAwaitingPrompt(calls: seq<SCall>, done: seq<TToolResult>): SPhase
{
  awaitingPrompt(calls, done)
}

function phAwaitingSummary(cut: int): SPhase
{
  awaitingSummary(cut)
}

function cmdCallProvider(): SCommand
{
  SCommand.callProvider
}

function cmdExecTool(call: SCall): SCommand
{
  execTool(call)
}

function cmdAskUser(call: SCall): SCommand
{
  askUser(call)
}

function cmdSkipTool(call: SCall, reason: Verdict): SCommand
{
  skipTool(call, reason)
}

function cmdSummarize(cut: int): SCommand
{
  summarize(cut)
}

function anchorTCall(c: TToolCall): TToolCall
{
  c
}

function anchorReq(req: Req): Req
{
  req
}

function anchorOutcome(o: Outcome): Outcome
{
  o
}

function toTCall(c: SCall): TToolCall
{
  TToolCall(c.id, c.name)
}

function projectCalls(calls: seq<SCall>): seq<TToolCall>
  decreases |calls|
  // hand-added (discharged by the recursion itself): the projection preserves
  // length, so batch facts stated over projectCalls transfer to the SCall list.
  ensures |projectCalls(calls)| == |calls|
{
  if (|calls| == 0) then
    []
  else
    ([toTCall(calls[0])] + projectCalls(calls[1..]))
}

lemma projectCalls_ensures(calls: seq<SCall>)
  ensures (|projectCalls(calls)| == |calls|)
{
}

function wellFormedModel(msgs: seq<TMsg>): bool
{
  wellFormed(msgs)
}

function pairsModel(calls: seq<TToolCall>, results: seq<TToolResult>): bool
{
  pairs(calls, results)
}

function inv(st: Session): bool
{
  var ph := st.phase;
  if (ph.toolBatch? || ph.awaitingPrompt?) then
    (((wellFormed(st.msgs) && (|ph.calls| > 0)) && (|ph.done| < |ph.calls|)) && pairsTo(projectCalls(ph.calls), ph.done))
  else
    match ph {
      case awaitingSummary(i_ph_cut) =>
        (((wellFormed(st.msgs) && (0 < i_ph_cut)) && (i_ph_cut <= |st.msgs|)) && ((i_ph_cut == |st.msgs|) || headOk(st.msgs[i_ph_cut])))
      case _ =>
        wellFormed(st.msgs)
    }
}

function initialSession(perms: PermState, cwd: seq<string>, maxTurns: int, compactKeep: int, autoCompactAt: int): Session
{
  Session(initialMsgs(), perms, cwd, phIdle(), 0, maxTurns, compactKeep, autoCompactAt, 0)
}

lemma initialSession_ensures(perms: PermState, cwd: seq<string>, maxTurns: int, compactKeep: int, autoCompactAt: int)
  ensures inv(initialSession(perms, cwd, maxTurns, compactKeep, autoCompactAt))
{
}

function verdictFor(st: Session, c: SCall): Verdict
{
  if !(c.known) then
    Verdict.skipUnknown
  else
    if (c.noPerm || decide(st.perms, st.cwd, c.req).Allow?) then
      if c.argsOk then
        Verdict.exec
      else
        Verdict.skipMissingArgs
    else
      if decide(st.perms, st.cwd, c.req).Deny? then
        Verdict.skipDenied
      else
        Verdict.prompt
}

lemma verdictFor_ensures(st: Session, c: SCall)
  ensures (verdictFor(st, c).exec? ==> (c.noPerm || isAllowed(st.perms, st.cwd, c.req)))
  ensures (verdictFor(st, c).prompt? ==> (!(c.noPerm) && !(isAllowed(st.perms, st.cwd, c.req))))
  ensures (st.perms.rejectPrompts ==> (!verdictFor(st, c).prompt?))
{
}

function requestProvider(st: Session): StepOut
  requires wellFormed(st.msgs)
{
  if ((st.maxTurns > 0) && (st.turns >= st.maxTurns)) then
    StepOut(st.(phase := phIdle()), [])
  else
    StepOut(st.(turns := (st.turns + 1), phase := phAwaitingProvider()), [cmdCallProvider()])
}

function finishBatch(st: Session, calls: seq<SCall>, done: seq<TToolResult>, stopped: bool): StepOut
  requires wellFormed(st.msgs)
  requires (|calls| > 0)
  requires pairs(projectCalls(calls), done)
{
  var msgs2 := appendAnsweredBlock(st.msgs, projectCalls(calls), done);
  if stopped then
    StepOut(st.(msgs := msgs2, phase := phIdle()), [])
  else
    requestProvider(st.(msgs := msgs2))
}

function advance(st: Session, calls: seq<SCall>, done: seq<TToolResult>): StepOut
  requires wellFormed(st.msgs)
  requires (|calls| > 0)
  requires (|done| < |calls|)
  requires pairsTo(projectCalls(calls), done)
  decreases (|calls| - |done|)
{
  var c := calls[|done|];
  var v := verdictFor(st, c);
  if v.exec? then
    StepOut(st.(phase := phToolBatch(calls, done)), [cmdExecTool(c)])
  else
    if v.prompt? then
      StepOut(st.(phase := phAwaitingPrompt(calls, done)), [cmdAskUser(c)])
    else
      var done2 := pushResult(projectCalls(calls), done, true);
      var r := (if (|done2| == |calls|) then finishBatch(st, calls, done2, false) else advance(st, calls, done2));
      StepOut(r.st, ([cmdSkipTool(c, v)] + r.cmds))
}

function recordAndContinue(st: Session, calls: seq<SCall>, done: seq<TToolResult>, isError: bool): StepOut
  requires wellFormed(st.msgs)
  requires (|calls| > 0)
  requires (|done| < |calls|)
  requires pairsTo(projectCalls(calls), done)
{
  var done2 := pushResult(projectCalls(calls), done, isError);
  if (|done2| == |calls|) then
    finishBatch(st, calls, done2, false)
  else
    advance(st, calls, done2)
}

function approvedCurrent(st: Session, calls: seq<SCall>, done: seq<TToolResult>, c: SCall): StepOut
  requires wellFormed(st.msgs)
  requires (|calls| > 0)
  requires (|done| < |calls|)
  requires pairsTo(projectCalls(calls), done)
{
  if !(c.argsOk) then
    var r := recordAndContinue(st, calls, done, true);
    StepOut(r.st, ([cmdSkipTool(c, Verdict.skipMissingArgs)] + r.cmds))
  else
    StepOut(st.(phase := phToolBatch(calls, done)), [cmdExecTool(c)])
}

function startCompact(st: Session, keep: int): StepOut
  requires wellFormed(st.msgs)
{
  if (keep < 0) then
    StepOut(st.(phase := phIdle()), [])
  else
    var cut := findCut(st.msgs, keep);
    if (cut == 0) then
      StepOut(st.(phase := phIdle()), [])
    else
      StepOut(st.(phase := phAwaitingSummary(cut)), [cmdSummarize(cut)])
}

function maybeAutoCompact(st: Session): StepOut
  requires wellFormed(st.msgs)
{
  if ((st.autoCompactAt <= 0) || (st.lastContextTokens <= st.autoCompactAt)) then
    StepOut(st.(phase := phIdle()), [])
  else
    startCompact(st, st.compactKeep)
}

function onUserInput(st: Session): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case idle =>
      requestProvider(st.(msgs := appendUserMsg(st.msgs)))
    case _ =>
      StepOut(st, [])
  }
}

function onCompactRequest(st: Session, keep: int): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case idle =>
      startCompact(st, keep)
    case _ =>
      StepOut(st, [])
  }
}

function onProviderReply(st: Session, calls: seq<SCall>, contextTokens: int): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case awaitingProvider =>
      var st2 := st.(lastContextTokens := contextTokens);
      if (|calls| == 0) then
        maybeAutoCompact(st2.(msgs := appendAssistantDone(st2.msgs)))
      else
        advance(st2, calls, startResults(projectCalls(calls)))
    case _ =>
      StepOut(st, [])
  }
}

function onProviderInterrupted(st: Session): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case awaitingProvider =>
      StepOut(st.(msgs := appendAssistantDone(st.msgs), phase := phIdle()), [])
    case _ =>
      StepOut(st, [])
  }
}

function onToolDone(st: Session, isError: bool): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case toolBatch(i_ph_calls, i_ph_done) =>
      recordAndContinue(st, i_ph_calls, i_ph_done, isError)
    case _ =>
      StepOut(st, [])
  }
}

function onPromptAnswer(st: Session, answer: Answer): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case awaitingPrompt(i_ph_calls, i_ph_done) =>
      var c := i_ph_calls[|i_ph_done|];
      if answer.no? then
        recordAndContinue(st, i_ph_calls, i_ph_done, true)
      else
        if answer.always? then
          approvedCurrent(st.(perms := grantFor(st.perms, st.cwd, c.req)), i_ph_calls, i_ph_done, c)
        else
          if answer.all? then
            approvedCurrent(st.(perms := grantAll(st.perms, st.cwd, c.req)), i_ph_calls, i_ph_done, c)
          else
            approvedCurrent(st, i_ph_calls, i_ph_done, c)
    case _ =>
      StepOut(st, [])
  }
}

function onBatchInterrupted(st: Session): StepOut
  requires inv(st)
{
  var ph := st.phase;
  if (ph.toolBatch? || ph.awaitingPrompt?) then
    finishBatch(st, ph.calls, fillRest(projectCalls(ph.calls), ph.done), true)
  else
    StepOut(st, [])
}

function onSummaryReady(st: Session, ok: bool): StepOut
  requires inv(st)
{
  var ph := st.phase;
  match ph {
    case awaitingSummary(i_ph_cut) =>
      if !(ok) then
        StepOut(st.(phase := phIdle()), [])
      else
        StepOut(st.(msgs := compact(st.msgs, i_ph_cut), phase := phIdle()), [])
    case _ =>
      StepOut(st, [])
  }
}

function step(st: Session, ev: SEvent): StepOut
  requires inv(st)
{
  match ev {
    case userInput =>
      onUserInput(st)
    case compactRequest(i_ev_keep) =>
      onCompactRequest(st, i_ev_keep)
    case providerReply(i_ev_calls, i_ev_contextTokens) =>
      onProviderReply(st, i_ev_calls, i_ev_contextTokens)
    case providerInterrupted =>
      onProviderInterrupted(st)
    case toolDone(i_ev_isError) =>
      onToolDone(st, i_ev_isError)
    case promptAnswer(i_ev_answer) =>
      onPromptAnswer(st, i_ev_answer)
    case batchInterrupted =>
      onBatchInterrupted(st)
    case summaryReady(i_ev_ok) =>
      onSummaryReady(st, i_ev_ok)
  }
}

function justified(st: Session, st2: Session, ev: SEvent, c: SCall): bool
{
  (c.noPerm || (isAllowed(st2.perms, st2.cwd, c.req) || (match ev { case promptAnswer(i_ev_answer) => (if (!i_ev_answer.yes?) then false else (var ph := st.phase; (match ph { case awaitingPrompt(i_ph_calls, i_ph_done) => (if (|i_ph_done| >= |i_ph_calls|) then false else (c == i_ph_calls[|i_ph_done|])) case _ => false }))) case _ => false })))
}

function stepMediation(st: Session, ev: SEvent, i: int): bool
  requires inv(st)
  requires (0 <= i)
  requires (i < |step(st, ev).cmds|)
  requires step(st, ev).cmds[i].execTool?
{
  true
}

lemma stepMediation_ensures(st: Session, ev: SEvent, i: int)
  requires inv(st)
  requires (0 <= i)
  requires (i < |step(st, ev).cmds|)
  requires step(st, ev).cmds[i].execTool?
  ensures justified(st, step(st, ev).st, ev, step(st, ev).cmds[i].call)
{
  StepOk(st, ev);
}

function stepPreservesInv(st: Session, ev: SEvent): bool
  requires inv(st)
{
  true
}

lemma stepPreservesInv_ensures(st: Session, ev: SEvent)
  requires inv(st)
  ensures inv(step(st, ev).st)
{
  StepOk(st, ev);
}

