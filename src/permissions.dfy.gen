datatype Outcome = Allow | Deny | Prompt

datatype PathGrant = PathGrant(tool: string, segs: seq<string>)

datatype PermState = PermState(autoAllow: set<string>, autoAllowCwd: set<string>, allowedTools: set<string>, allowedBashCommands: set<string>, allowedPaths: seq<PathGrant>, allowAll: bool, rejectPrompts: bool)

datatype Req = bash(command: string) | path(tool: string, segs: seq<string>, absolute: bool) | other(tool: string)

function decide(st: PermState, cwd: seq<string>, req: Req): Outcome
{
  if isAllowed(st, cwd, req) then
    Outcome.Allow
  else
    if st.rejectPrompts then
      Outcome.Deny
    else
      Outcome.Prompt
}

