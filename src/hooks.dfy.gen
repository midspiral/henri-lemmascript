// Generated by lsc from hooks.ts

datatype Option<T> = None | Some(value: T)

datatype Tool = Tool(name: string)

datatype Hook = Hook(tools: Option<seq<Tool>>, removeTools: Option<seq<string>>, pathBased: Option<seq<string>>, autoAllowCwd: Option<seq<string>>, autoAllow: Option<seq<string>>, rejectPrompts: Option<bool>, systemPrompt: Option<string>)

function hasName(tools: seq<Tool>, name: string): bool
  decreases |tools|
{
  if (|tools| == 0) then
    false
  else
    ((tools[0].name == name) || hasName(tools[1..], name))
}

function dedupTools(acc: seq<Tool>, tools: seq<Tool>, removes: seq<string>): seq<Tool>
  decreases |tools|
{
  if (|tools| == 0) then
    acc
  else
    var t := tools[0];
    var rest := tools[1..];
    if contains(removes, t.name) then
      dedupTools(acc, rest, removes)
    else
      if hasName(acc, t.name) then
        dedupTools(acc, rest, removes)
      else
        dedupTools((acc + [t]), rest, removes)
}

function allTools(defaults: seq<Tool>, hooks: seq<Hook>): seq<Tool>
  decreases |hooks|
{
  if (|hooks| == 0) then
    defaults
  else
    allTools((defaults + (match hooks[0].tools { case Some(i_oc0_val) => i_oc0_val case None => [] })), hooks[1..])
}

function allRemoves(hooks: seq<Hook>): seq<string>
  decreases |hooks|
{
  if (|hooks| == 0) then
    []
  else
    ((match hooks[0].removeTools { case Some(i_oc1_val) => i_oc1_val case None => [] }) + allRemoves(hooks[1..]))
}

function mergeTools(defaults: seq<Tool>, hooks: seq<Hook>): seq<Tool>
{
  dedupTools([], allTools(defaults, hooks), allRemoves(hooks))
}

function flatten(parts: seq<seq<string>>): seq<string>
  decreases |parts|
{
  if (|parts| == 0) then
    []
  else
    (parts[0] + flatten(parts[1..]))
}

function gather(base: seq<string>, parts: seq<seq<string>>): seq<string>
{
  (base + flatten(parts))
}

