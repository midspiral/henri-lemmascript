function contains(xs: seq<string>, x: string): bool
{
}
by method {
  var p := 0;
  while (p < |xs|)
    invariant (0 <= p)
    invariant (p <= |xs|)
    invariant (contains(xs, x) == contains(xs[p..], x))
    decreases (|xs| - p)
  {
    if (xs[p] == x) {
      return true;
    }
    p := (p + 1);
  }
  return false;
}
