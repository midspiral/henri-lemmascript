datatype TToolCall = TToolCall(id: string, name: string)

datatype TToolResult = TToolResult(toolCallId: string, isError: bool)

datatype TMsg = user | assistant(toolCalls: seq<TToolCall>) | tool(toolResults: seq<TToolResult>)

function makeResults(calls: seq<TToolCall>): seq<TToolResult>
  decreases |calls|
{
  if (|calls| == 0) then
    []
  else
    ([TToolResult(calls[0].id, false)] + makeResults(calls[1..]))
}

lemma makeResults_ensures(calls: seq<TToolCall>)
  ensures (|makeResults(calls)| == |calls|)
  ensures pairs(calls, makeResults(calls))
{
