function findCut(msgs: seq<TMsg>, keepRecent: int): int
  requires (0 <= keepRecent)
{
  var want := (if (|msgs| > keepRecent) then (|msgs| - keepRecent) else 0);
  snapBack(msgs, want)
}

lemma findCut_ensures(msgs: seq<TMsg>, keepRecent: int)
