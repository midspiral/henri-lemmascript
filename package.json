{
  "name": "henri-lemmascript",
  "version": "0.1.0",
  "description": "A hackable agent CLI in TypeScript, with its security- and protocol-critical core verified via LemmaScript (Dafny).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "henri": "src/cli.ts"
  },
  "scripts": {
    "henri": "tsx src/cli.ts",
    "test": "tsx test/smoke.ts && tsx test/session-smoke.ts && tsx test/permission-escape.ts && tsx test/self-smoke.ts",
    "test:gve": "tsx test/gve.ts && tsx test/gve-plan.ts && tsx test/gve-demo.ts && tsx test/gve-smoke.ts",
    "typecheck": "tsc --noEmit",
    "gen": "node ../LemmaScript/tools/dist/lsc.js gen --backend=dafny",
    "regen": "node ../LemmaScript/tools/dist/lsc.js regen --backend=dafny",
    "check": "node ../LemmaScript/tools/dist/lsc.js check --backend=dafny",
    "verify": "../LemmaScript/tools/check.sh dafny",
    "seal": "LEMMASCRIPT=../LemmaScript npx tsx ../lemmascript-seal/src/cli.ts seal",
    "seal:check": "LEMMASCRIPT=../LemmaScript npx tsx ../lemmascript-seal/src/cli.ts check",
    "gate": "scripts/gate.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1053.0",
    "guardians": "file:../guardians-lemmascript"
  }
}
